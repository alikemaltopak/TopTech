rules_version = '2';
// TOPTECH — Firebase Storage kuralları (proje: toptech-717ee)
service firebase.storage {
  match /b/{bucket}/o {
    // Profil fotoğrafları: profiles/{uid}/{dosya}. Sadece sahibi yükleyebilir; sadece resim, en fazla 5 MB.
    match /profiles/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // Eski yol (profiles/{email}_{zaman}) ve diğer her şey: yazma kapalı.
    // Daha önce yüklenmiş fotoğrafların indirme bağlantıları (token içerdikleri için) çalışmaya devam eder.
  }
}
